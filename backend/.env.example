PORT=3000
# Backend only. Leave blank to create tickets with OTHER / MEDIUM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI wait in milliseconds (default 5000, maximum 15000).
AI_TIMEOUT_MS=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/helpdesk"
MICROSOFT_TENANT_ID="YOUR_AU_DIRECTORY_TENANT_ID"
MICROSOFT_CLIENT_ID="YOUR_ENTRA_APP_CLIENT_ID"
MICROSOFT_ALLOWED_DOMAIN="au.edu"
